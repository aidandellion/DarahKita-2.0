"/>\r\n\r\n        <!-- aida punye -->\r\n        <activity android:name=\".activities.donor.EditProfileActivity\" android:exported=\"false\"/>\r\n        <activity android:name=\".activities.donor.ProfileActivity\" android:exported=\"false\"/>\r\n\r\n        <!-- splash screen, first thing user nmpk -->\r\n        <activity\r\n            android:name=\".activities.auth.SplashActivity\"\r\n            android:exported=\"true\"\r\n            android:theme=\"@style/Theme.DarahKita.NoActionBar\">\r\n            <intent-filter>\r\n                <action android:name=\"android.intent.action.MAIN\"/>\r\n                <category android:name=\"android.intent.category.LAUNCHER\"/>\r\n            </intent-filter>\r\n        </activity>\r\n\r\n        <!-- aiman punye, jgn tuch -->\r\n        <activity android:name=\".activities.donor.MapActivity\"/>\r\n\r\n        <!-- aida punye -->\r\n        <activity android:name=\".activities.auth.RegisterActivity\"/>\r\n        <activity android:name=\".activities.auth.LoginActivity\" android:exported=\"true\"/>\r\n        <activity android:name=\".activities.donor.DonorDashboardActivity\"/>\r\n\r\n        <!-- khai punye -->\r\n        <activity android:name=\".activities.staff.StaffDashboardActivity\" android:exported=\"false\"/>\r\n        <activity android:name=\".activities.staff.ProfileActivity\" android:exported=\"false\"/>\r\n\r\n        <!-- shaza punye -->\r\n        <activity android:name=\".activities.donor.BookingHubActivity\"/>\r\n        <activity android:name=\".activities.donor.DonationHistoryActivity\"/>\r\n        <activity android:name=\".activities.donor.EligibilityScreeningActivity\"/>\r\n        <activity android:name=\".activities.donor.SelectLocationActivity\"/>\r\n        <activity android:name=\".activities.donor.SelectDateTimeActivity\"/>\r\n        <activity android:name=\".activities.donor.DonationScheduleActivity\"/>\r\n\r\n        <!-- aiman punye - fcm notif handler -->\r\n        <service\r\n      
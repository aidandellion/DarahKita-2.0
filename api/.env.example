# Copy to .env for local runs. NEVER commit .env or the service account file.
# On Render, set these in Dashboard > Environment instead.

PORT=3000

# Firebase service account: paste the WHOLE JSON file content on one line.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# Shared secret for scheduled jobs (GitHub Actions sends it in x-job-secret)
JOB_SECRET=change-me-to-a-long-random-string

# Business rules (defaults shown)
WAIT_DAYS=56
CHECKIN_RADIUS_M=100
SLOT_CAPACITY=5

# EmailJS reminder email, sent server-side (enable "API calls for non-browser apps" in
# EmailJS > Account > Security). Use the same reminder service/template the app uses today;
# template params are: email, name, centre, date (yyyy-MM-dd), time (e.g. 09:00 AM).
# The booking confirmation email is still sent by the app.
EMAILJS_REMINDER_SERVICE_ID=
EMAILJS_REMINDER_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

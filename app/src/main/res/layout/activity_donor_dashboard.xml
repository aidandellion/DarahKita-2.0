<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#FFF5F2">

    <ScrollView
        android:layout_width="0dp" android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="24dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="16dp">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Welcome back," android:textSize="16sp" android:textColor="#9E9E9E"/>
                    <TextView android:id="@+id/tvWelcome" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Donor" android:textSize="28sp" android:textStyle="bold" android:textColor="#1A1A2E" android:layout_marginTop="2dp"/>
                </LinearLayout>

                <TextView android:id="@+id/tvBloodType" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="—" android:textSize="20sp" android:textStyle="bold" android:textColor="#FFFFFF"
                    android:background="@drawable/bg_blood_type_badge" android:paddingHorizontal="18dp" android:paddingVertical="14dp"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/llLowStockContainer" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginTop="24dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Announcements" android:textSize="20sp" android:textStyle="bold" android:textColor="#1A1A2E"
                android:layout_marginTop="24dp" android:layout_marginBottom="14dp"/>

            <LinearLayout android:id="@+id/llAnnouncementsContainer" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"/>

            <TextView android:id="@+id/tvUpcomingHeader" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Upcoming Booking" android:textSize="20sp" android:textStyle="bold" android:textColor="#1A1A2E"
                android:layout_marginTop="28dp" android:visibility="gone"/>

            <LinearLayout android:id="@+id/cardNextAppointment" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/bg_card_appointment_red" android:padding="20dp"
                android:layout_marginTop="14dp" android:visibility="gone">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="NEXT APPOINTMENT" android:textSize="12sp" android:textColor="#FFD9D6" android:textStyle="bold"/>
                        <TextView android:id="@+id/tvAppointmentCentre" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textSize="22sp" android:textStyle="bold" android:textColor="#FFFFFF" android:layout_marginTop="2dp"/>
                    </LinearLayout>
                    <FrameLayout android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_icon_box_translucent">
                        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ic_calendar_white"/>
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout android:id="@+id/rowAppointmentDetails" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="18dp">
                    <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_clock_white"/>
                    <TextView android:id="@+id/tvAppointmentTime" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="14sp" android:textColor="#FFFFFF" android:layout_marginStart="6dp" android:layout_marginEnd="18dp"/>
                    <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_location_white"/>
                    <TextView android:id="@+id/tvAppointmentLocation" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:textSize="14sp" android:textColor="#FFFFFF" android:layout_marginStart="6dp"/>
                </LinearLayout>

                <!-- navigate button - opens waze or google maps to the centre -->
                <Button
                    android:id="@+id/btnNavigateToAppointment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Navigate to Centre"
                    android:textColor="#FDFDFD"
                    android:textStyle="bold"
                    android:background="@drawable/bg_pill_white"
                    android:layout_marginTop="16dp"
                    android:visibility="gone"/>

            </LinearLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Nearby Donation Centres" android:textSize="20sp" android:textStyle="bold" android:textColor="#1A1A2E"
                android:layout_marginTop="28dp" android:layout_marginBottom="14dp"/>

            <LinearLayout android:id="@+id/centresContainer" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"/>

        </LinearLayout>
    </ScrollView>

    <include android:id="@+id/bottomNav" layout="@layout/bottom_nav_bar"
        android:layout_width="match_parent" android:layout_height="88dp"
        app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
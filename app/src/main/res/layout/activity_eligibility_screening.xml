<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#FFFFFF" android:padding="24dp">
    <TextView android:id="@+id/tvTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Eligibility Screening" android:textSize="26sp" android:textStyle="bold" android:textColor="#1A1A2E"
        android:layout_marginTop="24dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"/>
    <FrameLayout android:id="@+id/iconCircle" android:layout_width="96dp" android:layout_height="96dp"
        android:background="@drawable/bg_icon_circle" android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="center" android:src="@drawable/ic_shield_check"/>
    </FrameLayout>
    <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/questionCard" android:layout_width="0dp" android:layout_height="wrap_content"
        android:background="@drawable/bg_question_card" android:padding="24dp" android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/iconCircle" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <TextView android:id="@+id/tvQuestion" android:layout_width="0dp" android:layout_height="wrap_content"
            android:text="Are you currently in good health?" android:textSize="20sp" android:textColor="#1A1A2E" android:gravity="center"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout android:id="@+id/buttonRow" android:layout_width="0dp" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/questionCard" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <Button android:id="@+id/btnYes" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:layout_marginEnd="12dp"
            android:text="Yes" android:textColor="#1B5E20" android:textStyle="bold" android:background="@drawable/bg_btn_yes"/>
        <Button android:id="@+id/btnNo" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:layout_marginStart="12dp"
            android:text="No" android:textColor="#B71C1C" android:textStyle="bold" android:background="@drawable/bg_btn_no"/>
    </LinearLayout>
    <TextView android:id="@+id/tvProgress" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Question 1 of 9" android:textSize="14sp" android:textColor="#9E9E9E" android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/buttonRow" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>